# Server Configuration
PORT=9501
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_intake
# OR use individual parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ai_intake

# API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# CORS Configuration
FRONTEND_URL=http://localhost:9500

# For Railway deployment:
# PORT is automatically set by Railway
# DATABASE_URL will be ${{Postgres.DATABASE_URL}}
# FRONTEND_URL should be your Vercel production URL
